# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgres://drift:drift@localhost:5432/drift

# --- Privy (https://dashboard.privy.io) ---
PRIVY_APP_ID=
