# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgres://drift:drift@localhost:5432/drift

# --- Privy (https://dashboard.privy.io) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- p2pkit (PIX <-> USDC on/off-ramp) ---
P2PKIT_API_KEY=
P2PKIT_API_URL=https://api.p2p.me
# Shared secret for POST /webhooks/p2pkit. P2P.me sends it in the `x-webhook-secret`
# header on every order-status webhook; the receiver compares it in constant time.
# Empty = accept unauthenticated webhooks in development only (production rejects with 401).
P2PKIT_WEBHOOK_SECRET=
# Chain / asset used for settlement
P2PKIT_CHAIN=base
P2PKIT_ASSET=USDC
# Treasury wallet that receives trip payments
DRIFT_TREASURY_ADDRESS=

# --- DriftIntegrator smart contract (Base) ---
# Deployer key for src/contracts/deploy.ts — becomes the contract owner. NEVER commit.
PRIVATE_KEY=
# P2P Diamond address for the target network (ask the P2P.me team / p2p.me docs)
P2P_DIAMOND_ADDRESS=
# Optional overrides (deploy.ts defaults to Circle USDC + public RPCs)
USDC_ADDRESS=
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org
# Filled in after deploy
DRIFT_INTEGRATOR_ADDRESS=

# --- Contract verification (Etherscan API v2 — one key covers Basescan / Base Sepolia) ---
# Create it at https://etherscan.io/apidashboard. Used by src/contracts/verify.ts.
ETHERSCAN_API_KEY=
