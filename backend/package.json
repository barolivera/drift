{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset-booking": "tsx src/db/resetBooking.ts",
    "contract:compile": "tsx src/contracts/deploy.ts --compile-only",
    "deploy:contract": "tsx src/contracts/deploy.ts",
    "deploy:contract:mainnet": "tsx src/contracts/deploy.ts --network base",
    "verify:contract": "tsx src/contracts/verify.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@privy-io/server-auth": "^1.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "solc": "^0.8.28",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
