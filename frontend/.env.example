# Privy app id (public) — https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# Backend API base URL
VITE_API_URL=http://localhost:4000

# Chain used for USDC payments (must match backend P2PKIT_CHAIN)
VITE_CHAIN=base

# --- p2pkit Checkout (Base Sepolia) ---
# DriftIntegrator deployed by backend/src/contracts/deploy.ts
VITE_DRIFT_INTEGRATOR_ADDRESS=
# P2P Diamond (defaults to the widget's Sepolia Diamond 0xeb0B…beb9)
VITE_P2P_DIAMOND_ADDRESS=
# USDC the Diamond settles in. Sepolia: P2P test USDC 0x4095…040d (NOT Circle's). Mainnet: 0x8335…2913
VITE_USDC_ADDRESS=
# Subgraph for automatic circle routing (from P2P). If empty, set VITE_P2P_BRL_CIRCLE_ID.
VITE_P2P_SUBGRAPH_URL=
# Pin the BRL/PIX merchant circle (bigint). Required when VITE_P2P_SUBGRAPH_URL is empty.
VITE_P2P_BRL_CIRCLE_ID=
# "true" → widget fakes the on-chain lifecycle (no tx, no whitelisting needed). UX testing only.
VITE_P2P_DEMO=false
