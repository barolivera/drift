# Privy app id (public) — https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# Backend API base URL
VITE_API_URL=http://localhost:4000

# Default chain for the Privy wallet: base-sepolia while the integrator lives on testnet, base for production
VITE_CHAIN=base-sepolia

# --- p2pkit Checkout (Base Sepolia) ---
# DriftIntegrator deployed by backend/src/contracts/deploy.ts
VITE_DRIFT_INTEGRATOR_ADDRESS=
# P2P Diamond (defaults to the widget's Sepolia Diamond 0xeb0B…beb9)
VITE_P2P_DIAMOND_ADDRESS=
# USDC the Diamond settles in. Sepolia: P2P test USDC 0x4095…040d (NOT Circle's). Mainnet: 0x8335…2913
VITE_USDC_ADDRESS=
# Subgraph for automatic circle routing (from P2P). If empty, set VITE_P2P_BRL_CIRCLE_ID.
VITE_P2P_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1745491/event-indexer/v0.0.6
# Pin the BRL/PIX merchant circle (bigint). Required when VITE_P2P_SUBGRAPH_URL is empty.
VITE_P2P_BRL_CIRCLE_ID=
# "true" → widget fakes the on-chain lifecycle (no tx, no whitelisting needed). UX testing only.
# "true" only after enabling gas sponsorship for this app in the Privy dashboard;
# otherwise the embedded wallet pays gas itself (fund it with a little Base Sepolia ETH).
VITE_PRIVY_GAS_SPONSORSHIP=false
VITE_P2P_DEMO=false

# Telegram invite shown on the "Seat confirmed" screen (optional; the button is hidden when empty)
VITE_TELEGRAM_INVITE_URL=
